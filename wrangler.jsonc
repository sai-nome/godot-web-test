{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "godot-web-test",
  "compatibility_date": "2026-11-16",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "binding": "ASSETS",
    "run_worker_first": [
      "/index.wasm"
    ]
  },
  "main": "worker/index.js",
  "no_bundle": true
}
